import os, re, time, sqlite3, asyncio, base64, urllib.parse, socket, hashlib
from concurrent.futures import ThreadPoolExecutor
import requests
import urllib3
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes, MessageHandler, filters

BOT_TOKEN = os.getenv("BOT_TOKEN", "PUT_BOT_TOKEN_HERE")
ADMIN_ID = int(os.getenv("ADMIN_ID", "0"))
SUB_URL = "https://www.v2nodes.com/subscriptions/country/all/?key=ABD45A65D74F1DC"

DB = "data/bot.db"
V2NODES_IPS = [
    "188.114.96.6",
    "188.114.97.6",
]

V2NODES_HOST = "www.v2nodes.com"

MIN_PING = 1000
MAX_PING = 5000

FLAGS = ["🇩🇪","🇳🇱","🇫🇷","🇬🇧","🇺🇸","🇨🇦","🇫🇮","🇸🇪","🇨🇭","🇷🇴","🇹🇷","🇯🇵","🇸🇬","🇦🇪","🇭🇰"]

os.makedirs("data", exist_ok=True)

def db():
    return sqlite3.connect(DB)

def init_db():
    c = db()
    c.execute("""
    CREATE TABLE IF NOT EXISTS configs(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        config TEXT UNIQUE,
        ping INTEGER,
        flag TEXT,
        created INTEGER
    )
    """)
    c.execute("""
    CREATE TABLE IF NOT EXISTS proxies(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        proxy TEXT UNIQUE,
        created INTEGER
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS settings(
        key TEXT PRIMARY KEY,
        value TEXT
    )
    """)

    c.execute(
        "INSERT OR IGNORE INTO settings(key,value) VALUES('sub_url',?)",
        (SUB_URL,)
    )

    c.commit()
    c.close()


def get_sub_url():
    c = db()
    row = c.execute(
        "SELECT value FROM settings WHERE key='sub_url'"
    ).fetchone()
    c.close()

    if row:
        return row[0]

    return ""


def set_sub_url(url):
    c = db()
    c.execute(
        "INSERT OR REPLACE INTO settings(key,value) VALUES('sub_url',?)",
        (url,)
    )
    c.commit()
    c.close()


def delete_sub_url():
    c = db()
    c.execute(
        "DELETE FROM settings WHERE key='sub_url'"
    )
    c.commit()
    c.close()


def delete_all_proxies():
    c = db()
    c.execute("DELETE FROM proxies")
    c.commit()
    c.close()


def get_configs():
    c = db()
    rows = c.execute(
        "SELECT config,ping,flag FROM configs ORDER BY ping ASC"
    ).fetchall()
    c.close()
    return rows

def get_proxies():
    c = db()
    rows = c.execute("SELECT id,proxy FROM proxies ORDER BY id DESC").fetchall()
    c.close()
    return rows

def add_proxy(proxy):
    c = db()
    c.execute(
        "INSERT OR IGNORE INTO proxies(proxy,created) VALUES(?,?)",
        (proxy, int(time.time()))
    )
    c.commit()
    c.close()

def delete_proxy(pid):
    c = db()
    c.execute("DELETE FROM proxies WHERE id=?", (pid,))
    c.commit()
    c.close()

def extract_host_port(config):
    try:
        u = urllib.parse.urlparse(config)
        if u.hostname and u.port:
            return u.hostname, u.port
    except:
        pass
    return None

def tcp_ping(item):
    import socket
    host, port = item
    start = time.perf_counter()
    try:
        s = socket.create_connection((host, port), timeout=6)
        s.close()
        return int((time.perf_counter() - start) * 1000)
    except:
        return None


def get_country_flag(host):
    try:
        ip = socket.gethostbyname(host)

        r = requests.get(
            f"https://ipwho.is/{ip}",
            timeout=5
        )

        data = r.json()

        if data.get("success") is False:
            return "🌐"

        code = data.get("country_code", "").upper()

        if len(code) == 2:
            return "".join(
                chr(127397 + ord(c)) for c in code
            )

    except Exception:
        pass

    return "🌐"



def rename_config(config, flag):
    """
    حذف نام قبلی کانفیگ و جایگزینی با:
    #🇳🇱 @ByteTunnel
    """

    try:
        if "#" in config:
            base = config.split("#", 1)[0]
        else:
            base = config

        return f"{base}#{flag} @ByteTunnel"

    except Exception:
        return config


def decode_subscription(text):
    text = text.strip()

    try:
        if not re.search(r'://', text):
            text = base64.b64decode(text + "=" * (-len(text) % 4)).decode(
                "utf-8", errors="ignore"
            )
    except:
        pass

    return [
        x.strip()
        for x in text.splitlines()
        if "://" in x.strip()
    ]

def update_subscription():
    sub_url = get_sub_url()

    if not sub_url:
        return 0, 0

    r = requests.get(
        sub_url,
        timeout=30,
        headers={"User-Agent": "Mozilla/5.0"}
    )
    r.raise_for_status()

    configs = list(dict.fromkeys(decode_subscription(r.text)))

    targets = []

    for cfg in configs:
        hp = extract_host_port(cfg)

        if hp:
            targets.append((cfg, hp))

    results = []

    with ThreadPoolExecutor(max_workers=30) as ex:
        results = list(ex.map(lambda x: tcp_ping(x[1]), targets))

    valid = []

    for (cfg, (host, port)), ping in zip(targets, results):

        if ping is not None and MIN_PING <= ping <= MAX_PING:

            flag = get_country_flag(host)

            clean_config = rename_config(
                cfg,
                flag
            )

            valid.append({
                "config": clean_config,
                "ping": ping,
                "flag": flag
            })

    c = db()

    c.execute("DELETE FROM configs")

    for item in valid:
        c.execute(
            """
            INSERT OR IGNORE INTO configs
            (config,ping,flag,created)
            VALUES(?,?,?,?)
            """,
            (
                item["config"],
                item["ping"],
                item["flag"],
                int(time.time())
            )
        )

    c.commit()
    c.close()

    return len(configs), len(valid)


from telegram import ReplyKeyboardMarkup, ReplyKeyboardRemove


