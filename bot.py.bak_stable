async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id == ADMIN_ID:
        keyboard = admin_keyboard_reply()
    else:
        keyboard = user_keyboard()

    await update.message.reply_text(
        "🚀 به ByteTunnel خوش آمدید.\n\n"
        "از منوی پایین یکی از گزینه‌ها را انتخاب کنید.",
        reply_markup=keyboard
    )


async def admin(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        await update.message.reply_text("⛔ دسترسی ندارید.")
        return

    await update.message.reply_text(
        "👑 پنل مدیریت ByteTunnel",
        reply_markup=admin_panel_keyboard()
    )


async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()

    data = q.data

    # =========================
    # MAIN MENU
    # =========================

    if data == "home":
        await safe_edit(
            q,
            "🚀 منوی اصلی\n\nیکی از گزینه‌ها را انتخاب کنید:",
            main_keyboard()
        )
        return

    # =========================
    # CONFIGS
    # =========================

    if data == "configs":
        configs = get_configs()

        if not configs:
            await safe_edit(
                q,
                "❌ فعلاً کانفیگ سالمی پیدا نشد.",
                main_keyboard()
            )
            return

        # چرخش کانفیگ‌ها
        index = context.user_data.get("config_index", 0)

        if index >= len(configs):
            index = 0

        cfg, ping, flag = configs[index]

        context.user_data["config_index"] = (
            index + 1
        ) % len(configs)

        # پاک کردن نام قبلی کانفیگ و جایگزینی با @ByteTunnel
        clean_cfg = rename_config(cfg, flag)

        text = (
            f"{flag} @ByteTunnel\n\n"
            f"⚡ Ping: {ping}ms\n\n"
            f"`{clean_cfg}`"
        )

        keyboard = InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "📥 کانفیگ بعدی",
                    callback_data="configs"
                )
            ],
            [
                InlineKeyboardButton(
                    "🔙 بازگشت",
                    callback_data="home"
                )
            ]
        ])

        await safe_edit(
            q,
            text,
            keyboard,
            parse_mode="Markdown"
        )
        return

    # =========================
    # PROXIES
    # =========================

    if data == "proxies":
        proxies = get_proxies()

        if not proxies:
            await safe_edit(
                q,
                "❌ هنوز پروکسی‌ای اضافه نشده.",
                main_keyboard()
            )
            return

        _, proxy = proxies[0]

        text = f"🌐 پروکسی\n\n`{proxy}`"

        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("🌐 پروکسی بعدی", callback_data="proxies")],
            [InlineKeyboardButton("🔙 بازگشت", callback_data="home")]
        ])

        await safe_edit(
            q,
            text,
            keyboard,
            parse_mode="Markdown"
        )
        return

    # =========================
    # ADMIN SECURITY
    # =========================

    if update.effective_user.id != ADMIN_ID:
        return

    # =========================
    # ADMIN PANEL
    # =========================

    if data == "admin":
        await safe_edit(
            q,
            "👑 پنل مدیریت ByteTunnel",
            admin_keyboard()
        )
        return

    # =========================
    # UPDATE SUB
    # =========================

    if data == "update":
        await safe_edit(
            q,
            "⏳ در حال دریافت و تست کانفیگ‌ها..."
        )

        try:
            total, good = await asyncio.to_thread(
                update_subscription
            )

            await safe_edit(
                q,
                f"✅ آپدیت انجام شد.\n\n"
                f"📥 دریافت‌شده: {total}\n"
                f"⚡ قابل استفاده: {good}\n"
                f"📊 محدوده پینگ: {MIN_PING}-{MAX_PING}ms",
                admin_keyboard()
            )

        except Exception as e:
            await safe_edit(
                q,
                f"❌ خطا:\n`{str(e)[:1000]}`",
                admin_keyboard(),
                parse_mode="Markdown"
            )

        return

    # =========================
    # STATS
    # =========================

    if data == "stats":
        configs = get_configs()
        proxies = get_proxies()

        await safe_edit(
            q,
            f"📊 آمار ByteTunnel\n\n"
            f"📡 کانفیگ‌ها: {len(configs)}\n"
            f"🌐 پروکسی‌ها: {len(proxies)}\n"
            f"⚡ پینگ مجاز: {MIN_PING}-{MAX_PING}ms",
            admin_keyboard()
        )
        return

    # =========================
    # ADD PROXY
    # =========================

    if data == "add_proxy":
        context.user_data["adding_proxy"] = True

        await safe_edit(
            q,
            "➕ پروکسی را ارسال کن.\n\n"
            "مثال:\n"
            "`http://user:pass@1.2.3.4:8080`",
            parse_mode="Markdown"
        )
        return

    # =========================
    # DELETE PROXY
    # =========================

    if data == "delete_proxy":
        proxies = get_proxies()

        if not proxies:
            await safe_edit(
                q,
                "❌ پروکسی‌ای برای حذف وجود ندارد.",
                admin_keyboard()
            )
            return

        buttons = []

        for pid, proxy in proxies:
            buttons.append([
                InlineKeyboardButton(
                    f"🗑 {proxy[:35]}",
                    callback_data=f"del:{pid}"
                )
            ])

        buttons.append([
            InlineKeyboardButton(
                "🔙 برگشت",
                callback_data="admin"
            )
        ])

        await safe_edit(
            q,
            "🗑 پروکسی موردنظر را انتخاب کن:",
            InlineKeyboardMarkup(buttons)
        )
        return

    # =========================
    # DELETE CONFIRMED
    # =========================

    if data.startswith("del:"):
        try:
            pid = int(data.split(":", 1)[1])
            delete_proxy(pid)

            await safe_edit(
                q,
                "✅ پروکسی حذف شد.",
                admin_keyboard()
            )

        except Exception as e:
            await safe_edit(
                q,
                f"❌ خطا:\n`{str(e)}`",
                admin_keyboard(),
                parse_mode="Markdown"
            )

        return

async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    text = update.message.text.strip()

    is_admin = uid == ADMIN_ID

    # ==========================
    # USER
    # ==========================

    if text == "➡️ کانفیگ بعدی":
        configs = get_configs()

        if not configs:
            await update.message.reply_text(
                "❌ فعلاً کانفیگ قابل ارائه‌ای وجود ندارد."
            )
            return

        idx = context.user_data.get("config_index", 0)
        idx = (idx + 1) % len(configs)
        context.user_data["config_index"] = idx

        config = configs[idx]

        try:
            flag = get_country_flag(
                urllib.parse.urlparse(config).hostname
                or ""
            )
        except Exception:
            flag = "🌐"

        clean = rename_config(config, flag)

        # اگر دیتابیس پینگ را نگه می‌دارد، نمایش بده
        ping_text = ""
        try:
            row = configs[idx]
            if isinstance(row, (tuple, list)) and len(row) > 1:
                ping_text = f"\\n📡 Ping: {row[1]} ms"
        except Exception:
            pass

        await update.message.reply_text(
            f"{flag} @ByteTunnel{ping_text}\\n\\n"
            f"<code>{clean}</code>",
            parse_mode="HTML"
        )
        return

    if text == "📥 دریافت کانفیگ":
        configs = get_configs()

        if not configs:
            await update.message.reply_text(
                "❌ فعلاً کانفیگی با پینگ ۱۰۰۰ تا ۵۰۰۰ms پیدا نشد."
            )
            return

        index = context.user_data.get("config_index", 0)

        if index >= len(configs):
            index = 0

        cfg, ping, flag = configs[index]

        context.user_data["config_index"] = (
            index + 1
        ) % len(configs)

        clean_cfg = rename_config(cfg, flag)

        await update.message.reply_text(
            f"{flag} @ByteTunnel\n\n"
            f"⚡ Ping: {ping}ms\n\n"
            f"{clean_cfg}"
        )
        return

    if text == "🌐 دریافت پروکسی":
        proxies = get_proxies()

        if not proxies:
            await update.message.reply_text(
                "❌ فعلاً پروکسی‌ای موجود نیست."
            )
            return

        index = context.user_data.get("proxy_index", 0)

        if index >= len(proxies):
            index = 0

        _, proxy = proxies[index]

        context.user_data["proxy_index"] = (
            index + 1
        ) % len(proxies)

        await update.message.reply_text(
            f"🌐 پروکسی\n\n{proxy}"
        )
        return

    if not is_admin:
        return

    # ==========================
    # ADMIN MENU
    # ==========================

    if text == "👑 پنل مدیریت":
        await update.message.reply_text(
            "👑 پنل مدیریت ByteTunnel",
            reply_markup=admin_panel_keyboard()
        )
        return

    if text == "🔙 منوی اصلی":
        await update.message.reply_text(
            "🚀 منوی اصلی",
            reply_markup=admin_keyboard_reply()
        )
        return

    # ==========================
    # UPDATE SUB
    # ==========================

    if text == "🔄 آپدیت ساب":
        await update.message.reply_text(
            "⏳ در حال دریافت و تست کانفیگ‌ها..."
        )

        try:
            total, good = await asyncio.to_thread(
                update_subscription
            )

            await update.message.reply_text(
                f"✅ آپدیت انجام شد.\n\n"
                f"📥 دریافت‌شده: {total}\n"
                f"⚡ قبول‌شده: {good}\n"
                f"🎯 پینگ مجاز: {MIN_PING}-{MAX_PING}ms"
            )

        except Exception as e:
            await update.message.reply_text(
                f"❌ خطا:\n{str(e)[:1000]}"
            )

        return

    # ==========================
    # STATS
    # ==========================

    if text == "📊 آمار":
        configs = get_configs()
        proxies = get_proxies()
        sub = get_sub_url()

        await update.message.reply_text(
            f"📊 آمار ByteTunnel\n\n"
            f"📡 کانفیگ‌ها: {len(configs)}\n"
            f"🌐 پروکسی‌ها: {len(proxies)}\n"
            f"🎯 پینگ: {MIN_PING}-{MAX_PING}ms\n"
            f"🔗 ساب: {'فعال ✅' if sub else 'حذف شده ❌'}"
        )
        return

    # ==========================
    # CHANGE SUB
    # ==========================

    if text == "🔗 تغییر ساب‌لینک":
        context.user_data["waiting_sub"] = True

        await update.message.reply_text(
            "🔗 ساب‌لینک جدید را ارسال کن:"
        )
        return

    # ==========================
    # DELETE SUB
    # ==========================

    if text == "🗑 حذف ساب‌لینک":
        delete_sub_url()

        c = db()
        c.execute("DELETE FROM configs")
        c.commit()
        c.close()

        await update.message.reply_text(
            "✅ ساب‌لینک حذف شد.\n"
            "🗑 کانفیگ‌های مربوط به آن هم پاک شدند."
        )
        return

    # ==========================
    # ADD PROXY
    # ==========================

    if text == "➕ افزودن پروکسی":
        context.user_data["waiting_proxy"] = True

        await update.message.reply_text(
            "➕ پروکسی جدید را ارسال کن:"
        )
        return

    # ==========================
    # SHOW PROXIES
    # ==========================

    if text == "📋 پروکسی‌ها":
        proxies = get_proxies()

        if not proxies:
            await update.message.reply_text(
                "❌ پروکسی‌ای وجود ندارد."
            )
            return

        out = "📋 پروکسی‌های ذخیره‌شده:\n\n"

        for i, (_, proxy) in enumerate(proxies, 1):
            out += f"{i}. {proxy}\n"

        await update.message.reply_text(out)
        return

    # ==========================
    # DELETE ALL PROXIES
    # ==========================

    if text == "🗑 حذف تمام پروکسی‌ها":
        delete_all_proxies()

        await update.message.reply_text(
            "✅ تمام پروکسی‌های قبلی حذف شدند."
        )
        return

    # ==========================
    # RECEIVE NEW SUB
    # ==========================

    if context.user_data.get("waiting_sub"):
        if text.startswith("http://") or text.startswith("https://"):

            set_sub_url(text)

            context.user_data["waiting_sub"] = False

            await update.message.reply_text(
                "✅ ساب‌لینک جدید ذخیره شد.\n\n"
                "برای دریافت کانفیگ‌های جدید، "
                "گزینه «🔄 آپدیت ساب» را بزن."
            )
        else:
            await update.message.reply_text(
                "❌ ساب‌لینک معتبر نیست."
            )

        return

    # ==========================
    # RECEIVE NEW PROXY
    # ==========================

    if context.user_data.get("waiting_proxy"):

        add_proxy(text)

        context.user_data["waiting_proxy"] = False

        await update.message.reply_text(
            "✅ پروکسی اضافه شد."
        )

        return


async def auto_update(app):
    while True:
        try:
            await asyncio.to_thread(update_subscription)
            print("Subscription updated.")
        except Exception as e:
            print("Update error:", e)

        await asyncio.sleep(1800)

async def start_auto_update(app):
    try:
        await auto_update(app)
    except asyncio.CancelledError:
        pass
    except Exception as e:
        print(f"Auto update error: {e}")

async def post_init(app):
    asyncio.create_task(start_auto_update(app))

def run():
    init_db()

    app = (
        Application.builder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("admin", admin))
    app.add_handler(CallbackQueryHandler(button))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler))

    print("ByteTunnelBot started...")
    app.run_polling()

if __name__ == "__main__":
    run()
