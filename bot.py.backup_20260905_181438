def is_admin(user_id):
    return user_id in ADMIN_IDS


def extract_configs(text):
    pattern = re.compile(
        r"(?:vless|vmess|trojan|ss|ssr|socks5?|http|hysteria2|hy2|tuic)://[^\s<>\"]+",
        re.IGNORECASE
    )

    result = []

    for config in pattern.findall(text):
        config = config.rstrip("),]}>'\"")

        if config not in result:
            result.append(config)

    return result


def protocol_of(config):
    x = config.lower()

    if x.startswith("vless://"):
        return "VLESS"
    if x.startswith("vmess://"):
        return "VMess"
    if x.startswith("trojan://"):
        return "Trojan"
    if x.startswith("ss://"):
        return "Shadowsocks"
    if x.startswith("ssr://"):
        return "SSR"
    if x.startswith("hysteria2://") or x.startswith("hy2://"):
        return "Hysteria2"
    if x.startswith("tuic://"):
        return "TUIC"
    if x.startswith("socks"):
        return "SOCKS"
    if x.startswith("http://"):
        return "HTTP"

    return "Other"


async def http_get(url, timeout=30):
    proxies = get_proxies()

    # اول بدون proxy
    try:
        async with httpx.AsyncClient(
            timeout=timeout,
            follow_redirects=True
        ) as client:
            r = await client.get(url)
            r.raise_for_status()
            return r.text
    except Exception as direct_error:
        last_error = direct_error

    # سپس Proxyهای ذخیره‌شده
    for item in proxies:
        proxy = item["proxy"]

        try:
            async with httpx.AsyncClient(
                timeout=timeout,
                follow_redirects=True,
                proxy=proxy
            ) as client:
                r = await client.get(url)
                r.raise_for_status()
                print(f"[PROXY OK] {proxy}")
                return r.text
        except Exception as e:
            last_error = e
            print(f"[PROXY ERROR] {proxy} -> {e}")

    raise last_error


# =========================================================
# CONFIG UPDATE
# =========================================================

async def update_configs():
    global configs, last_update

    async with update_lock:
        try:
            # از index.json برای پیدا کردن مسیرهای فعلی استفاده می‌کنیم
            index_text = await http_get(INDEX_URL)
            index_data = __import__("json").loads(index_text)

            sources = []

            categories = index_data.get(
                "cascade_categories",
                {}
            )

            # verified
            verified = categories.get("verified", {})
            verified_files = verified.get("files", {})

            verified_url = verified_files.get("configs_txt")

            if verified_url:
                sources.append(verified_url)
            else:
                sources.append(RAW_BASE + "verified/configs.txt")

            # fallback
            if not sources:
                sources.append(RAW_BASE + "verified/configs.txt")

            new_configs = []

            for url in sources:
                try:
                    text = await http_get(url)
                    new_configs.extend(extract_configs(text))
                except Exception as e:
                    print(f"[SOURCE ERROR] {url} -> {e}")

            configs = list(dict.fromkeys(new_configs))
            last_update = time.time()

            print(
                f"[UPDATE] {len(configs)} configs loaded"
            )

        except Exception as e:
            print(f"[UPDATE ERROR] {e}")


