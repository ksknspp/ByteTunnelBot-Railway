def get_proxies():
    conn = db()
    rows = conn.execute(
        "SELECT * FROM proxies WHERE enabled=1 ORDER BY id"
    ).fetchall()
    conn.close()
    return [dict(x) for x in rows]


def add_proxy(proxy):
    conn = db()

    try:
        conn.execute(
            "INSERT INTO proxies(proxy,enabled,added_at) VALUES(?,?,?)",
            (proxy, 1, datetime.now(__import__('datetime').timezone.utc).isoformat())
        )
        conn.commit()
        result = True
    except sqlite3.IntegrityError:
        result = False

    conn.close()
    return result


def delete_proxy(proxy_id):
    conn = db()
    cur = conn.execute(
        "DELETE FROM proxies WHERE id=?",
        (proxy_id,)
    )
    conn.commit()
    ok = cur.rowcount > 0
    conn.close()
    return ok


def clear_proxies():
    conn = db()
    conn.execute("DELETE FROM proxies")
    conn.commit()
    conn.close()


