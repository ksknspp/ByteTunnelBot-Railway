async def auto_update():
    while True:
        interval = int(
            setting(
                "update_interval",
                DEFAULT_INTERVAL
            )
        )

        await asyncio.sleep(interval)

        try:
            await update_configs()
        except Exception as e:
            print("[AUTO UPDATE ERROR]", e)


async def post_init(application):
    init_db()
    await update_configs()
    application.bot_data["auto_update_task"] = asyncio.create_task(auto_update())



