async def proxy_callback(update, context):
    query = update.callback_query

    if not is_admin(query.from_user.id):
        await query.answer("⛔ دسترسی ندارید.", show_alert=True)
        return

    await query.answer()

    action = query.data.split(":", 1)[1]

    if action == "add":
        context.user_data["waiting_proxy"] = True

        await query.message.reply_text(
            "➕ Proxy را در پیام بعدی ارسال کن.\n\n"
            "مثال:\n"
            "<code>http://127.0.0.1:8080</code>\n\n"
            "یا:\n"
            "<code>socks5://127.0.0.1:1080</code>",
            parse_mode=ParseMode.HTML
        )

    elif action == "list":
        proxies = get_proxies()

        if not proxies:
            await query.message.reply_text(
                "📋 هیچ Proxy فعالی ثبت نشده."
            )
            return

        text = "🌐 <b>Proxyهای فعال:</b>\n\n"

        buttons = []

        for p in proxies:
            text += f"#{p['id']} — <code>{p['proxy']}</code>\n"

            buttons.append([
                InlineKeyboardButton(
                    f"🗑 حذف #{p['id']}",
                    callback_data=f"proxydelete:{p['id']}"
                )
            ])

        await query.message.reply_text(
            text,
            parse_mode=ParseMode.HTML,
            reply_markup=InlineKeyboardMarkup(buttons)
        )

    elif action == "clear":
        clear_proxies()

        await query.message.reply_text(
            "🗑 همه Proxyها حذف شدند."
        )

    elif action == "test":
        proxies = get_proxies()

        if not proxies:
            await query.message.reply_text(
                "❌ Proxy فعالی وجود ندارد."
            )
            return

        msg = await query.message.reply_text(
            "🧪 تست Proxyها شروع شد..."
        )

        results = []

        for p in proxies:
            proxy = p["proxy"]

            try:
                start = time.perf_counter()

                async with httpx.AsyncClient(
                    proxy=proxy,
                    timeout=10
                ) as client:
                    r = await client.get(
                        "https://api.github.com"
                    )

                ms = int(
                    (time.perf_counter() - start) * 1000
                )

                results.append(
                    f"🟢 #{p['id']} — {ms}ms"
                )

            except Exception:
                results.append(
                    f"🔴 #{p['id']} — FAIL"
                )

        await msg.edit_text(
            "🧪 <b>نتیجه تست Proxy</b>\n\n" +
            "\n".join(results),
            parse_mode=ParseMode.HTML
        )


